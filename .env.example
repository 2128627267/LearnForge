# ===========================================
# LearnForge 环境变量配置示例
# 复制为 .env.local 并填写实际值
# ===========================================

# 数据库配置（SQLite 文件路径）
DATABASE_URL="file:./data/learnforge.db"

# NextAuth 配置
NEXTAUTH_SECRET="change-me-to-a-random-secret-string"
NEXTAUTH_URL="http://localhost:3000"

# AI 服务配置（默认使用 OpenAI 兼容协议，可对接 DeepSeek/智谱/Moonshot 等）
AI_PROVIDER="openai"
AI_API_KEY="your-api-key-here"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# 应用配置
APP_NAME="LearnForge"
APP_LOCALE="zh-CN"
