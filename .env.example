# ===========================================
# LearnForge 环境变量配置示例
# 复制为 .env.local 并填写实际值
# ===========================================

# 数据库配置（SQLite 文件路径）
DATABASE_URL="file:./data/learnforge.db"

# NextAuth 配置
NEXTAUTH_SECRET="change-me-to-a-random-secret-string"
NEXTAUTH_URL="http://localhost:3000"

# AI 服务配置（默认使用 OpenAI 兼容协议，可对接 DeepSeek/智谱/Moonshot 等）
AI_PROVIDER="openai"
AI_API_KEY="your-api-key-here"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# 应用配置
APP_NAME="LearnForge"
APP_LOCALE="zh-CN"

# 可选安全加固：本地 API 访问令牌
# 配置后所有 /api/* 请求必须携带 x-local-token header。
# 前端页面会自动从 /api/local-token（仅 localhost 可访问）获取并携带。
# 局域网模式（start-dev-lan.bat）下自动获取端点禁用（防伪造 Host 窃取令牌），
# 各设备首次访问时在浏览器弹窗中手动输入一次令牌即可（localStorage 记住）。
# 局域网 / 内网穿透 / 生产部署时强烈建议设置。留空 = 本地单机默认开放。
LOCAL_ACCESS_TOKEN=
